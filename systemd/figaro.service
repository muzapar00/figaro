[Unit]
Description=Figaro voice assistant daemon (DeepSeek brain + local voice IO)
Documentation=file:///home/mzpr00/Projects/figaro/docs/ipc.md
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/node /home/mzpr00/Projects/figaro/bin/figaro daemon
WorkingDirectory=/home/mzpr00/Projects/figaro
Environment=HOME=/home/mzpr00
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PATH=/home/mzpr00/node-v24.22.2-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
# A missing or broken voice module degrades to text; it is not a crash loop.
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=10
SyslogIdentifier=figaro
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
