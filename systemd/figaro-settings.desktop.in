[Desktop Entry]
Type=Application
Version=1.0
Name=费加罗
Name[en]=Figaro
GenericName=语音助手设置与自测
Comment=费加罗语音助手的 macOS 风格设置面板：灵敏度、误唤醒、麦克风、语音与识别自测
Exec=env FIGARO_SETTINGS_GL=1 @QS@ --no-duplicate -c figaro-settings
Icon=figaro
Terminal=false
Categories=Settings;
Keywords=figaro;费加罗;voice;wake;settings;asr;tts;
StartupNotify=true
StartupWMClass=org.quickshell
